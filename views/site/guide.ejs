<% }) %>
<div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:30px"><a class="btn am" href="/products">ดูรุ่นแอร์</a><a class="btn ln" href="/pricing-clean">ดูค่าล้างแอร์</a><a class="btn ln" href="/contact">สอบถามทีมงาน</a></div>
</main>
<%- include('../partials/site-footer') %>
</body></html>
