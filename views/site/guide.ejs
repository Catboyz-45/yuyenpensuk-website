<!DOCTYPE html>
<html lang="th">
<head><%- include('../partials/site-head', {title:guide.title, fullTitle:guide.fullTitle, desc:guide.description}) %></head>
<body class="ys-ref ys-guide">
<%- include('../partials/site-header') %>
