<!DOCTYPE html>
<html lang="th">
<head><%- include('../partials/site-head',{title:'ยี่ห้อ '+brandName, desc:'เครื่องปรับอากาศยี่ห้อ '+brandName+' ครบทุกรุ่นพร้อมราคา บริการติดตั้งโดยช่างประจำบริษัท ราคารวมค่าติดตั้งมาตรฐาน'}) %></head>
<body class="ys-ref ys-brand ys-designed ys-brand">
<%- include('../partials/site-header') %>
<section class="page-hero brand-hero">
  <div class="sec brand-hero-inner">
    <div class="crumb2"><a href="/">หน้าแรก</a> / <a href="/products">สินค้า</a> / <b><%= brandName %></b></div>
    <span class="eyebrow-dot">Air Conditioner Brand</span>
    <h1><%= brandName %></h1>
    <p>เครื่องปรับอากาศยี่ห้อ <%= brandName %> ที่บริษัทเป็นตัวแทนจำหน่าย ทั้งหมด <%= products.length %> รุ่น พร้อมบริการติดตั้งโดยช่างประจำบริษัท</p>
    <div class="hv4-cta" style="margin-top:20px">
      <a class="btn am" href="/contact"><iconify-icon icon="mdi:message-text-outline"></iconify-icon> สอบถามรุ่นที่เหมาะกับคุณ</a>
      <a class="btn gh" href="/products">ดูสินค้าทั้งหมด</a>
    </div>
  </div>
</section>

<section class="sec">
  <div class="chips" data-brand-chips>
    <a class="chip" href="/products">ทุกยี่ห้อ</a>
    <% brands.forEach(b=>{ %><a class="chip <%= b===brandName?'on':'' %>" href="/brands/<%= encodeURIComponent(b) %>"><%= b %></a><% }) %>
  </div>

  <div class="shead">
    <div><span class="eyebrow-dot">Products</span><h2>เครื่องปรับอากาศ <%= brandName %></h2></div>
    <a href="/products">กลับไปหน้าสินค้าทั้งหมด <iconify-icon icon="mdi:arrow-right"></iconify-icon></a>
  </div>

  <div class="g4">
    <% products.forEach(p=>{ %>
    <a class="card product-card-new" href="/products/<%= p.id %>">
      <div class="ph prod product-photo" data-product-id="<%= p.id %>">
        <div class="photo-loading"><iconify-icon icon="mdi:air-conditioner"></iconify-icon><span>กำลังโหลดรูป</span></div>
        <img class="product-photo-img" alt="<%= p.brand %> <%= p.model %>" loading="lazy" style="display:none">
        <% if(p.badge){ %><span class="tag product-badge"><%= p.badge %></span><% } %>
      </div>
      <div class="bd">
        <div class="product-brand-line"><span class="brand-mini"><%= p.brand %></span><span class="product-type"><%= p.type %></span></div>
        <h3><%= p.name %></h3>
        <div class="product-model"><%= p.model %></div>
        <div class="product-spec-line"><strong><%= p.spec.split(' · ')[0] %></strong><span><%= p.spec.split(' · ').slice(1).join(' · ') %></span></div>
        <div class="price-row"><span class="price ask">สอบถามราคา</span><span class="detail-link">ดูรายละเอียด <iconify-icon icon="mdi:arrow-right"></iconify-icon></span></div>
      </div>
    </a>
    <% }) %>
    <% if(!products.length){ %><p style="color:var(--mut)">ยังไม่มีสินค้ายี่ห้อนี้ในระบบ</p><% } %>
  </div>

  <div class="pnote" style="background:var(--frost);color:var(--pine)">
    <iconify-icon icon="mdi:image-multiple-outline" style="color:var(--pine)"></iconify-icon>
    <span>กดที่สินค้าเพื่อดูรายละเอียด สเปก และภาพเพิ่มเติม · ราคารวมค่าติดตั้งมาตรฐาน</span>
  </div>
</section>

<%- include('../partials/site-footer') %>
</body>
</html>
