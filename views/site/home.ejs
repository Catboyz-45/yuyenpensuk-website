<!DOCTYPE html>
<html lang="th">
<head><%- include('../partials/site-head',{fullTitle:'ล้างแอร์ ติดตั้งแอร์ ซื้อแอร์พร้อมติดตั้ง กรุงเทพฯ | อยู่เย็นเป็นสุข', title:'หน้าแรก', desc:'บริการล้างแอร์ ติดตั้งแอร์ และจำหน่ายแอร์พร้อมติดตั้ง กรุงเทพฯ คลองสามวา มีนบุรี และพื้นที่รอบกรุงเทพฯ สอบถามราคาและนัดหมาย โทร ' + company.phone}) %></head>
<body class="yp-home ys-hero-live">
<%- include('../partials/site-header') %>

<!-- YS Homepage Hero: native HTML/CSS, photo kept separate from buttons and text -->
<section class="ys-hero" aria-labelledby="ys-hero-title">
  <div class="ys-hero-photo" aria-hidden="true"></div>
  <div class="ys-hero-slope" aria-hidden="true"></div>
  <div class="ys-hero-slope-edge" aria-hidden="true"></div>
  <div class="ys-hero-inner">
    <div class="ys-hero-copy">
      <div class="ys-hero-eyebrow"><iconify-icon icon="mdi:leaf-outline"></iconify-icon> บริการแอร์ครบวงจร เขตกรุงเทพฯ และปริมณฑล</div>
      <%
        // หัวข้อหลักแก้ได้จากหลังบ้าน (ข้อมูลบริษัท > หัวข้อหลักหน้าแรก) แสดงเป็น 2 บรรทัด: บรรทัดแรกสีขาว บรรทัดที่สองสีเขียว
        // ตัดบรรทัดหลังคำว่า "และ" ถ้ามี ไม่อย่างนั้นตัดที่ช่องว่างสุดท้าย
        const heroTitle = String(homeContent.homepage_hero_title || "").trim() || "ติดตั้ง ล้าง ซ่อม และจำหน่ายเครื่องปรับอากาศ";
        const andAt = heroTitle.indexOf("และ", 1);
        const cut = andAt > 0 ? andAt + 3 : heroTitle.lastIndexOf(" ") + 1;
        let heroLines = [heroTitle.slice(0, cut).trim(), heroTitle.slice(cut).trim()];
        if (!heroLines[1]) heroLines = ["", heroTitle];
        const heroWrap = heroLines.some((l) => l.length > 28) ? ' style="white-space:normal"' : "";
      %>
      <h1 id="ys-hero-title"><% if (heroLines[0]) { %><span<%- heroWrap %>><%= heroLines[0] %></span><% } %><strong<%- heroWrap %>><%= heroLines[1] %></strong></h1>
      <p><%= homeContent.homepage_hero_description || "ดูแลเครื่องปรับอากาศครบวงจร ตั้งแต่เลือกซื้อ ติดตั้ง ดูแลรักษา จนถึงงานไฟฟ้าที่เกี่ยวข้อง โดยทีมช่างผู้ชำนาญ" %></p>
      <div class="ys-hero-actions">
        <a href="/products" class="ys-hero-button ys-hero-button-primary"><iconify-icon icon="mdi:cart-outline"></iconify-icon> เลือกซื้อแอร์ <iconify-icon icon="mdi:chevron-right"></iconify-icon></a>
        <a href="/services" class="ys-hero-button ys-hero-button-secondary"><iconify-icon icon="mdi:wrench-outline"></iconify-icon> ดูบริการทั้งหมด <iconify-icon icon="mdi:chevron-right"></iconify-icon></a>
      </div>
    </div>
    <div class="ys-hero-benefits" aria-label="จุดเด่นบริการ">
      <div class="ys-hero-benefit"><span><iconify-icon icon="mdi:snowflake"></iconify-icon></span><b>เย็นสบาย</b><small>ทุกฤดูกาล</small></div>
      <div class="ys-hero-benefit"><span><iconify-icon icon="mdi:shield-check-outline"></iconify-icon></span><b>ใส่ใจมาตรฐาน</b><small>งานติดตั้ง</small></div>
      <div class="ys-hero-benefit"><span><iconify-icon icon="mdi:tools"></iconify-icon></span><b>ดูแลรักษา</b><small>เครื่องปรับอากาศ</small></div>
      <div class="ys-hero-benefit"><span><iconify-icon icon="mdi:flash-outline"></iconify-icon></span><b>งานไฟฟ้า</b><small>ที่เกี่ยวข้อง</small></div>
    </div>
  </div>
  <% if (banners.length) { %>
    <div class="ys-hero-announcements"><% banners.forEach(b=>{ %><span><iconify-icon icon="mdi:bullhorn-outline"></iconify-icon> <%= b.title %></span><% }) %></div>
  <% } %>
</section>

<!-- ===== จุดเด่นของบริษัท: Real Photography ===== -->
<section class="sec alt why-showcase why-photo-showcase">
  <div class="shead why-showcase-head">
    <div>
      <span class="eyebrow-dot">Why Choose Us</span>
      <h2>จุดเด่นของบริษัท</h2>
      <p class="why-intro">
        ดูแลทุกขั้นตอนด้วยความใส่ใจ ตั้งแต่เลือกสินค้า ติดตั้ง
        ไปจนถึงบริการหลังการขาย
      </p>
    </div>
  </div>

  <% const featureRows = Array.isArray(homeFeatures) ? homeFeatures : [
    {id:1,title:'ทีมช่างมืออาชีพ',subtitle:'PROFESSIONAL TEAM',description:'ชำนาญงานเครื่องปรับอากาศโดยเฉพาะ ให้ความสำคัญกับความเรียบร้อยและความปลอดภัยในทุกขั้นตอน',points:['ตรวจสอบหน้างานก่อนเริ่มงาน','อธิบายขั้นตอนให้เข้าใจก่อนดำเนินการ'],image:homeContent.homepage_team_image || 'https://images.pexels.com/photos/8065903/pexels-photo-8065903.jpeg?auto=compress&cs=tinysrgb&w=1200'},
    {id:2,title:'แอร์ของแท้ 100%',subtitle:'GENUINE PRODUCTS',description:'คัดสรรเครื่องปรับอากาศจากแบรนด์ชั้นนำ พร้อมข้อมูลสินค้าและเงื่อนไขการรับประกันจากศูนย์',points:['แบรนด์ชั้นนำ 6 ยี่ห้อ','แจ้งรายละเอียดและการรับประกันชัดเจน'],image:homeContent.homepage_product_image || '/uploads/products/101-ftkf-yv2s-1.jpg'},
    {id:3,title:'บริการรวดเร็ว',subtitle:'FAST RESPONSE',description:'ประสานงานนัดหมายเข้าหน้างานภายใน 24 ชั่วโมง พร้อมแจ้งรายละเอียดและราคาก่อนเริ่มงานทุกครั้ง',points:['นัดหมายและประสานงานชัดเจน','สอบถามรายละเอียดก่อนตัดสินใจได้'],image:homeContent.homepage_service_image || 'https://images.pexels.com/photos/30572791/pexels-photo-30572791.jpeg?auto=compress&cs=tinysrgb&w=1200'}
  ]; %>
  <% featureRows.forEach((f,i)=>{ const n=String(i+1).padStart(2,'0'); %>
  <article class="why-row <%= i%2 ? 'why-row-reverse' : '' %>">
    <div class="why-visual why-photo-frame <%= i%2 ? 'why-product-photo' : '' %>">
      <% if(f.image){ %><img src="<%= f.image %>" alt="<%= f.title %>" loading="lazy"><% } %>
      <span class="why-photo-label"><%= n %> / <%= f.subtitle || 'OUR STRENGTH' %></span>
    </div>
    <div class="why-copy">
      <div class="why-kicker"><span><%= n %></span> <%= f.subtitle || 'OUR STRENGTH' %></div>
      <h3><%= f.title %></h3>
      <p><%= f.description %></p>
      <% if(Array.isArray(f.points) && f.points.length){ %><ul class="why-points"><% f.points.forEach(point=>{ %><li><%= point %></li><% }) %></ul><% } %>
    </div>
  </article>
  <% }) %>
</section>

<!-- ===== บริการ: การ์ดสีทึบ 4 บล็อก ===== -->
<section class="sec">
  <div class="shead"><div><span class="eyebrow-dot">Our Services</span><h2>งานบริการของเรา</h2></div><a href="/services">ดูทั้งหมด <iconify-icon icon="mdi:arrow-right"></iconify-icon></a></div>
  <div class="svc-blocks">
    <% const cc=['c1','c2','c3','c4']; services.forEach((s,i)=>{ %>
    <a class="svc-block <%= cc[i%4] %>" href="/services/<%= s.id %>">
      <div class="wm"><%= String(i+1).padStart(2,'0') %></div>
      <iconify-icon class="ico" icon="<%= s.icon %>"></iconify-icon>
      <h3><%= s.title %></h3>
      <p><%= s.description.slice(0,56) %>...</p>
    </a>
    <% }) %>
  </div>
</section>

<!-- ===== ส่วนซื้อขายแอร์ ===== -->
<section class="sec alt">
  <div class="shead"><div><span class="eyebrow-dot">Air Conditioners</span><h2>แอร์ขายดี แนะนำ</h2></div><a href="/products">ดูแอร์ทั้งหมด <iconify-icon icon="mdi:arrow-right"></iconify-icon></a></div>
  <div class="g4">
    <% products.forEach(p=>{ %>
    <a class="card" href="/products/<%= p.id %>">
      <div class="ph prod product-photo" data-product-id="<%= p.id %>">
        <div class="photo-loading"><iconify-icon icon="mdi:air-conditioner"></iconify-icon><span>กำลังโหลดรูป</span></div>
        <img class="product-photo-img" alt="<%= p.brand %> <%= p.model %>" loading="lazy" style="display:none">
        <% if(p.badge){ %><span class="tag" style="position:absolute;top:10px;left:10px;background:var(--pine);color:#fff"><%= p.badge %></span><% } %>
      </div>
      <div class="bd">
        <span class="tag bl"><%= p.brand %></span>
        <h3 style="margin-top:7px"><%= p.name %></h3>
        <p><%= p.spec.split('·')[0].trim() %></p>
        <div class="price-row">
          <span class="price <%= p.price ? '' : 'ask' %>"><%= p.price ? '฿'+p.price.toLocaleString() : 'สอบถามราคา' %></span>
          <iconify-icon icon="mdi:arrow-right-circle-outline" style="color:var(--brass);font-size:19px"></iconify-icon>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <div class="pnote" style="background:var(--frost);color:var(--pine)">
    <iconify-icon icon="mdi:shield-check-outline" style="color:var(--pine)"></iconify-icon>
    <span>ราคารวมค่าติดตั้งมาตรฐาน · ผ่อน 0% นานสูงสุด 10 เดือน · รับประกันคอมเพรสเซอร์ 5 ปี — <a href="/payment" style="font-weight:600;color:var(--pine);text-decoration:underline">ดูวิธีชำระเงิน</a></span>
  </div>
</section>

<section class="sec">
  <div class="shead"><div><span class="eyebrow-dot">Selected Works</span><h2>ผลงานติดตั้งที่ผ่านมา</h2></div><a href="/projects">ดูทั้งหมด <iconify-icon icon="mdi:arrow-right"></iconify-icon></a></div>
  <div class="project-gallery-grid home-project-gallery">
    <% projects.forEach(p=>{ %>
    <a class="project-gallery-card" href="/projects/<%= p.id %>">
      <div class="project-gallery-photo">
        <% if(p.image){ %>
          <img src="<%= p.image %>" alt="<%= p.title %>" loading="eager" onerror="this.style.display='none'">
        <% } else { %>
          <iconify-icon icon="mdi:office-building-outline"></iconify-icon>
        <% } %>
      </div>
      <div class="project-gallery-info">
        <h3><%= p.title %></h3>
        <div class="project-gallery-meta">
          <span><%= p.place || p.category %></span>
          <span><%= p.year %></span>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
</section>

<!-- ===== แบรนด์ + สถิติสีสัน ===== -->
<section class="sec alt">
  <div class="shead"><div><span class="eyebrow-dot">Brands</span><h2>แบรนด์ที่จำหน่าย</h2></div><a href="/products">ดูสินค้าทั้งหมด <iconify-icon icon="mdi:arrow-right"></iconify-icon></a></div>
  <div class="brandrow" style="margin-bottom:32px"><% brands.forEach(b=>{ %><a class="brand" href="/brands/<%= encodeURIComponent(b) %>"><%= b %></a><% }) %></div>
  <div class="stat-colors">
    <div class="c"><div class="n"><%= brands.length %>+</div><div class="l">แบรนด์ชั้นนำ</div></div>
    <div class="c"><div class="n"><%= productCount %>+</div><div class="l">รุ่นให้เลือก</div></div>
    <div class="c"><div class="n"><%= projectCount %>+</div><div class="l">ผลงานติดตั้ง</div></div>
    <div class="c"><div class="n">9+</div><div class="l">ปีประสบการณ์</div></div>
  </div>
</section>

<section class="sec">
  <div class="shead"><div><span class="eyebrow-dot">Pricing &amp; Payment</span><h2>ค่าบริการและการชำระเงิน</h2></div></div>
  <div class="g3">
    <a class="feat" href="/pricing-install" style="display:block"><div class="icowrap"><iconify-icon icon="mdi:currency-usd"></iconify-icon></div><h3>ค่าบริการติดตั้งแอร์</h3><p>อัตราค่าติดตั้งตามขนาดและประเภทเครื่อง</p></a>
    <a class="feat" href="/pricing-clean" style="display:block"><div class="icowrap"><iconify-icon icon="mdi:air-filter"></iconify-icon></div><h3>ค่าบริการล้างแอร์</h3><p>อัตราค่าล้างพร้อมส่วนลดล้างหลายเครื่อง</p></a>
    <a class="feat" href="/payment" style="display:block"><div class="icowrap"><iconify-icon icon="mdi:credit-card-outline"></iconify-icon></div><h3>วิธีการชำระเงิน</h3><p>โอนธนาคาร พร้อมเพย์ เงินสด หรือผ่อน 0%</p></a>
  </div>
</section>

<section class="sec alt ctasec">
  <h2>พร้อมให้คำปรึกษาฟรี ไม่มีค่าใช้จ่าย</h2>
  <p>โทร <%= company.phone %> · Line: <%= company.line %> · จันทร์–เสาร์ 8:00–17:30</p>
  <a class="btn am" href="/contact"><iconify-icon icon="mdi:phone-outline"></iconify-icon> ติดต่อเรา</a>
</section>

<%- include('../partials/site-footer') %>
</body>
</html>
