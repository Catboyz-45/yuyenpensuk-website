<!DOCTYPE html>
<html lang="th">
<head><%- include('../partials/site-head',{fullTitle:'บริการล้างแอร์ ติดตั้งแอร์ ซ่อมแอร์ กรุงเทพฯ | อยู่เย็นเป็นสุข', title:'บริการของเรา', desc:'บริการติดตั้งแอร์ ล้าง ซ่อม เติมน้ำยา จำหน่ายแอร์และอะไหล่ และงานไฟฟ้าที่เกี่ยวกับระบบปรับอากาศ โดยช่างผู้ชำนาญ'}) %></head>
<body class="ys-ref ys-services ys-designed ys-services">
<%- include('../partials/site-header') %>
<section class="page-hero services-hero">
  <div class="sec services-hero-inner">
    <div class="crumb2"><a href="/">หน้าแรก</a> / <b>บริการของเรา</b></div>
    <span class="eyebrow-dot">Our Services</span>
    <h1>งานบริการของเรา</h1>
    <p>รับงานเครื่องปรับอากาศครบวงจร เลือกดูรายละเอียดของแต่ละบริการ หรือติดต่อทีมงานเพื่อให้เข้าสำรวจหน้างานก่อนเสนอราคา</p>
  </div>
</section>

<section class="sec">

  <form class="srch" method="get" action="/services">
    <div class="inpw">
      <iconify-icon icon="mdi:magnify"></iconify-icon>
      <input name="q" value="<%= q %>" placeholder="ค้นหาบริการ เช่น ติดตั้งแอร์, ล้างแอร์, งานไฟฟ้า">
    </div>
    <button class="btn nv">ค้นหา</button>
  </form>

  <div class="service-gallery-grid">
    <% services.forEach(s=>{ %>
      <a class="service-gallery-card" href="/services/<%= s.id %>">
        <div class="service-gallery-photo">
          <% if(s.image){ %>
            <img src="<%= s.image %>" alt="<%= s.title %>" loading="lazy">
          <% } else { %>
            <iconify-icon icon="<%= s.icon %>"></iconify-icon>
          <% } %>
        </div>
        <div class="service-gallery-body">
          <h3><%= s.title %></h3>
          <p><%= s.description %></p>
          <span class="service-gallery-link">ดูรายละเอียด →</span>
        </div>
      </a>
    <% }) %>
    <% if(!services.length){ %><p style="color:var(--mut)">ไม่พบบริการที่ค้นหา ลองใช้คำอื่น</p><% } %>
  </div>
</section>

<section class="sec alt ctasec">
  <h2>ต้องการให้ประเมินหน้างานก่อน?</h2>
  <p>ทีมงานเข้าสำรวจและเสนอราคาโดยไม่มีค่าใช้จ่าย · โทร <%= company.phone %></p>
  <a class="btn am" href="/contact"><iconify-icon icon="mdi:calendar-check-outline"></iconify-icon> นัดหมายทีมงาน</a>
</section>

<%- include('../partials/site-footer') %>
</body>
</html>
