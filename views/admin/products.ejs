<!DOCTYPE html>
<html lang="th">
<head><%- include('../partials/admin-head',{title:'จัดการสินค้า'}) %></head>
<body>
<div class="cms">
<%- include('../partials/admin-shell-top',{heading:'จัดการสินค้า'}) %>

  <%
    // จัดกลุ่มสินค้าตามยี่ห้อ — แต่ละยี่ห้อเป็นหมวดแยกกัน ไม่ปนกัน
    const groups = {};
    rows.forEach(p => { const b = p.brand || 'ไม่ระบุยี่ห้อ'; (groups[b] = groups[b] || []).push(p); });
    // route ส่งรายการแบรนด์มาในชื่อ brandList (แบรนด์ที่ยังไม่มีสินค้าก็ต้องเลือกได้)
    const brandMeta = typeof brandList !== "undefined" ? brandList : [];
    const brandNames = [...new Set([...brandMeta.map(b=>b.name),...Object.keys(groups)])].sort();
    const selectedBrand = typeof presetBrand !== "undefined" ? presetBrand : "";
    const brandColors = ['#0E4D6B','#2C6B4C','#8a6224','#12402B','#A0742A','#0E6E63'];
  %>

  <% const editorMode = !!editing || String(typeof presetBrand !== 'undefined' ? presetBrand : '') !== '' || (typeof queryAdd !== 'undefined' && queryAdd) ; %>
  <div class="banana-product-page" data-editor-mode="<%= editing ? 'edit' : 'list' %>">
    <div class="banana-toolbar">
      <div><p class="banana-eyebrow">PRODUCT WORKSPACE</p><h2><%= editing ? 'แก้ไขสินค้า' : 'คลังสินค้า' %></h2><p class="banana-subtitle"><%= editing ? 'แก้ไขข้อมูลและรูปภาพโดยไม่ต้องเลื่อนผ่านรายการสินค้า' : 'ค้นหาและจัดการสินค้าทั้งหมด '+rows.length+' รายการ ได้อย่างรวดเร็ว' %></p></div>
      <a class="banana-primary" href="/admin/products?add=1<%= selectedBrand ? "&brand="+encodeURIComponent(selectedBrand) : "" %>"><iconify-icon icon="mdi:plus"></iconify-icon> เพิ่มสินค้า</a>
    </div>
    <div class="banana-list-view" id="banana-list-view">
      <div class="banana-brand-head"><div><h3>เลือกแบรนด์สินค้า</h3><p>เลือกหมวดหมู่เพื่อดูรุ่นสินค้าในแบรนด์นั้น</p></div><a class="banana-manage-brands" href="/admin/product-brands">จัดการแบรนด์และโลโก้ →</a></div>
      <div class="banana-brand-grid" id="banana-brand-grid">
        <% brandNames.forEach(b=>{const meta=brandMeta.find(x=>x.name===b);const n=(groups[b]||[]).length; %>
          <a class="banana-brand-card" href="/admin/products?brand=<%= encodeURIComponent(b) %>" data-brand-link="<%= b %>">
            <span class="banana-brand-logo"><% if(meta&&meta.logo){ %><img src="<%= meta.logo %>" alt="โลโก้ <%= b %>" loading="lazy"><% }else{ %><span class="banana-brand-wordmark"><%= b %></span><% } %></span>
            <span class="banana-brand-info"><strong><%= b %></strong><small><%= n %> รุ่นสินค้า</small></span><span class="banana-brand-arrow">→</span>
          </a>
        <% }) %>
      </div>
      <div id="banana-brand-products" hidden><div class="banana-brand-products-heading"><a href="/admin/products" class="banana-back">← เลือกแบรนด์อื่น</a><h3 id="banana-selected-title"></h3><a class="banana-primary" id="banana-brand-add" href="/admin/products?add=1">+ เพิ่มสินค้าในแบรนด์นี้</a></div>
      <% if(!selectedBrand){ %><div class="banana-brands-redirect"><h3>เลือกแบรนด์เพื่อจัดการสินค้า</h3><p>จัดหมวดหมู่สินค้าเป็นแบรนด์ เพื่อค้นหาและแก้ไขได้ง่ายขึ้น</p><a class="banana-primary" href="/admin/product-brands">ดูหมวดหมู่และโลโก้แบรนด์ →</a></div><% }else{ %><div class="banana-selected-brand"><a href="/admin/product-brands">← กลับไปเลือกแบรนด์</a><h3>สินค้าแบรนด์ <%= selectedBrand %></h3></div><% } %>
      <div class="banana-filterbar" <%= !selectedBrand ? "hidden" : "" %>><label class="banana-search"><iconify-icon icon="mdi:magnify"></iconify-icon><input id="banana-search" type="search" placeholder="ค้นหาชื่อสินค้า รุ่น หรือยี่ห้อ…" autocomplete="off"></label><select id="banana-brand-filter" aria-label="กรองยี่ห้อ"><option value="">ทุกยี่ห้อ</option><% brandNames.forEach(b=>{ %><option value="<%= b %>" <%= b === selectedBrand ? "selected" : "" %>><%= b %></option><% }) %></select><span class="banana-count" id="banana-count"><%= rows.length %> รายการ</span></div>
      <div class="banana-table-card" <%= !selectedBrand ? "hidden" : "" %>><div class="tblwrap"><table class="tbl banana-table"><thead><tr><th>สินค้า</th><th>รุ่น / ยี่ห้อ</th><th>ราคา</th><th>ไฟล์แนบ</th><th>จัดการ</th></tr></thead><tbody>
      <% rows.forEach(p=>{ %><tr data-banana-product data-brand="<%= p.brand || '' %>" data-search="<%= [p.name,p.brand,p.model].filter(Boolean).join(' ').toLowerCase() %>">
      <td><div class="banana-product-cell"><span class="thumb admin-prod-thumb" data-product-id="<%= p.id %>"><% if(p.image){ %><img src="<%= p.image %>" loading="lazy"><% }else{ %><iconify-icon icon="mdi:air-conditioner"></iconify-icon><% } %></span><strong><%= p.name %></strong></div></td>
      <td><span class="banana-brand"><%= p.brand || 'ไม่ระบุ' %></span><div class="banana-model"><%= p.model || '—' %></div></td>
      <td><%= p.price ? '฿'+Number(p.price).toLocaleString() : 'สอบถามราคา' %></td>
      <td><% if(p.catalog){ %><a href="<%= p.catalog %>" target="_blank" rel="noopener">PDF</a><% }else{ %>—<% } %></td>
      <td><div class="act2"><a class="banana-edit" href="/admin/products?edit=<%= p.id %>&brand=<%= encodeURIComponent(p.brand||'') %>"><iconify-icon icon="mdi:pencil-outline"></iconify-icon> แก้ไข</a><form method="post" action="/admin/products/delete/<%= p.id %>" data-confirm="ยืนยันลบสินค้านี้?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="banana-delete" type="submit" title="ลบสินค้า"><iconify-icon icon="mdi:trash-can-outline"></iconify-icon></button></form></div></td></tr><% }) %>
      </tbody></table></div><p class="banana-empty" id="banana-empty" hidden>ไม่พบสินค้าที่ค้นหา</p></div></div>
    </div>
  <div class="panel banana-editor" id="add-form" data-editing="<%= editing ? "1" : "0" %>">
    <div class="ph2"><h3><%- editing ? '<iconify-icon icon="mdi:pencil-outline"></iconify-icon> แก้ไขสินค้า' : '<iconify-icon icon="mdi:plus"></iconify-icon> เพิ่มสินค้าใหม่' %><% if(!editing && presetBrand){ %> — หมวด <%= presetBrand %><% } %></h3><% if(editing){ %><a class="btn ln" href="/admin/products?brand=<%= encodeURIComponent(editing.brand || '') %>">กลับไปรายการสินค้า</a><% } %></div>
    <div class="banana-editor-intro"><% if(!editing){ %><a href="/admin/product-brands" class="banana-back"><iconify-icon icon="mdi:arrow-left"></iconify-icon> กลับไปเลือกแบรนด์</a><% } %><p>กรอกข้อมูลตามหมวด แล้วกดบันทึกเมื่อพร้อม</p></div><nav class="banana-tabs" aria-label="หมวดข้อมูลสินค้า"><button type="button" class="banana-tab is-active" data-tab="basic">ข้อมูลทั่วไป</button><button type="button" class="banana-tab" data-tab="price">ราคา</button><button type="button" class="banana-tab" data-tab="desc">รายละเอียด</button><button type="button" class="banana-tab" data-tab="img">รูปภาพ</button></nav><form class="pb banana-edit-form" method="post" action="/admin/products/save" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="id" value="<%= editing ? editing.id : '' %>">

      <div class="fsection" data-section="basic">
        <h4><iconify-icon icon="mdi:information-outline"></iconify-icon> ข้อมูลพื้นฐาน</h4>
        <div class="fgrid">
          <div class="fld"><label>ชื่อสินค้า</label><input name="name" value="<%= editing ? editing.name : '' %>" required></div>
          <div class="fld">
            <label>ยี่ห้อ (หมวดหมู่)</label>
            <select name="brand" required><option value="">เลือกแบรนด์</option><% brandNames.forEach(b=>{ %><option value="<%= b %>" <%= (editing ? editing.brand : presetBrand)===b ? "selected" : "" %>><%= b %></option><% }) %></select>
            <datalist id="brandlist"><% (typeof brandList !== "undefined" ? brandList.map(b=>b.name) : brandNames).forEach(b=>{ %><option value="<%= b %>"><% }) %></datalist>
            <p class="hint">เพิ่มหรือแก้ไขแบรนด์และโลโก้ได้ที่ <a href="/admin/product-brands">จัดการแบรนด์</a></p>
          </div>
          <div class="fld"><label>รุ่น</label><input name="model" value="<%= editing ? editing.model : '' %>"></div>
          <div class="fld"><label>ประเภท</label><input name="type" value="<%= editing ? editing.type : '' %>" placeholder="เช่น ติดผนัง / ฝังฝ้า 4 ทิศทาง"></div>
        </div>
      </div>

      <div class="fsection price" data-section="price">
        <h4><iconify-icon icon="mdi:currency-usd"></iconify-icon> ราคา</h4>
        <div class="fgrid">
          <div class="fld"><label>ราคา (บาท) — เว้นว่างหรือ 0 = สอบถามราคา</label><input name="price" type="number" value="<%= editing ? editing.price : '' %>"></div>
          <div class="fld"><label>ราคาก่อนลด (ถ้ามี)</label><input name="priceOld" type="number" value="<%= editing ? editing.priceOld : '' %>"></div>
          <div class="fld full"><label>ป้าย (เช่น ขายดี, สินค้าใหม่)</label><input name="badge" value="<%= editing ? editing.badge : '' %>"></div>
          <div class="fld full">
            <label style="display:flex;align-items:center;gap:8px;font-weight:600">
              <input type="checkbox" name="bestseller" style="width:auto" <%= editing && editing.bestseller ? 'checked' : '' %>>
              แสดงในหมวด "แอร์ขายดี แนะนำ" หน้าแรก
            </label>
            <p class="hint">ติ๊กเพื่อให้สินค้านี้ขึ้นแสดงในส่วนซื้อขายแอร์บนหน้าแรกของเว็บไซต์</p>
          </div>
        </div>
      </div>

      <div class="fsection desc" data-section="desc">
        <h4><iconify-icon icon="mdi:text-box-outline"></iconify-icon> รายละเอียดสินค้า</h4>
        <div class="fgrid">
          <div class="fld full"><label>สเปกโดยย่อ (แสดงในการ์ดสินค้า)</label><input name="spec" value="<%= editing ? editing.spec : '' %>" placeholder="เช่น 12,300 BTU · SEER 18.5 · R32"></div>
          <div class="fld full"><label>รายละเอียด (แสดงในหน้ารายละเอียดสินค้า)</label><textarea name="description"><%= editing ? editing.description : '' %></textarea></div>
        </div>
      </div>

      <div class="fsection img" data-section="img">
        <h4><iconify-icon icon="mdi:image-multiple-outline"></iconify-icon> รูปภาพ</h4>

        <p class="banana-image-hint">เลือกรูปหลักและแกลเลอรี ระบบจะแสดงภาพตัวอย่างแบบย่อเพื่อไม่ให้หน้ายาว และสามารถกด Crop ก่อนบันทึกได้</p>
        <div class="fgrid">
          <div class="fld"><label>รูปภาพสินค้า (รูปหลัก)</label><input type="file" name="image" accept="image/*"<% if (editing && editing.image) { %> data-saved-image="<%= editing.image %>"<% } %>></div>
          <div class="fld"><label>ไฟล์แนบ (PDF)</label><input type="file" name="catalog" accept="application/pdf"></div>
          <div class="fld full">
            <label>แกลเลอรีรูปภาพ (เลือกได้สูงสุด 5 รูปพร้อมกัน)</label>
            <input type="file" name="gallery" accept="image/*" multiple>
            <input type="hidden" name="galleryOrder" value="">
            <% if (editing && Array.isArray(editing.gallery) && editing.gallery.length) { %>
            <div class="admin-cover-picker">
              <label for="admin-cover-select">รูปหน้าปกสินค้า (เลือกจากรูปที่บันทึกไว้)</label>
              <select id="admin-cover-select" name="coverFromGallery">
                <option value="">ใช้รูปหน้าปกปัจจุบัน</option>
                <% editing.gallery.forEach((g, i) => { %><option value="<%= g %>">ใช้รูปแกลเลอรีเดิมลำดับ <%= i + 1 %> เป็นหน้าปก</option><% }) %>
              </select>
              <p class="hint">เมื่อเลือกหน้าปกใหม่ รูปหน้าปกเดิมจะย้ายไปอยู่ในแกลเลอรี ไม่ลบไฟล์เดิม · ใช้ได้เมื่อไม่ได้อัปโหลดรูปใหม่หรือสั่งล้างแกลเลอรี</p>
            </div>
            <% } %>
            <p class="hint">เมื่อเลือกรูปใหม่ จะสามารถจัดลำดับก่อนบันทึกได้ รูปแรกในชุดแกลเลอรีจะแสดงก่อน (รูปหลักแยกต่างหาก)</p>
            <p class="hint">เลือกไฟล์ใหม่จะแทนที่ชุดเดิมทั้งหมด ถ้าไม่เลือกไฟล์ใหม่ รูปเดิมจะยังอยู่</p>
            <% if (editing) { %>
            <div class="admin-remote-gallery" data-product-id="<%= editing.id %>" style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
              <span class="hint">กำลังโหลดรูปสินค้าจริง…</span>
            </div>
            <% if (editing.gallery && editing.gallery.length) { %>
            <div style="margin-top:8px;color:var(--mut);font-size:12px">รูปที่อัปโหลดไว้ในระบบ</div>
            <div class="admin-saved-gallery" style="display:flex;gap:8px;margin-top:6px;flex-wrap:wrap">
              <% editing.gallery.forEach(g=>{ %><span class="thumb" style="width:60px;height:60px"><img src="<%= g %>" loading="lazy"></span><% }) %>
            </div>
            <% } %>
            <label style="display:flex;align-items:center;gap:8px;margin-top:10px;font-weight:400">
              <input type="checkbox" name="clearGallery" style="width:auto"> ล้างแกลเลอรีที่อัปโหลดเดิมทั้งหมด (ไม่อัปโหลดรูปใหม่)
            </label>
            <% } %>
          </div>
        </div>
      </div>

      <div class="banana-savebar"><a href="/admin/product-brands" class="banana-cancel">ยกเลิก</a><button class="btn nv" type="submit"><%= editing ? 'บันทึกการแก้ไข' : 'เพิ่มสินค้า' %></button></div>
    </form>
  </div>
  </div><!-- banana product page -->

<%- include('../partials/admin-shell-bottom') %>
</div>
<script src="/js/admin-product-thumbs.js" defer></script>
<script src="/js/admin-banana-products.js" defer></script>
<script src="/js/admin-gallery-v2.js" defer></script>
<script src="/js/admin-image-crop-v2.js" defer></script>
</body>
</html>
