<!DOCTYPE html>
<html lang="th">
<head><%- include('../partials/admin-head',{title:'การชำระเงิน'}) %></head>
<body>
<div class="cms">
<%- include('../partials/admin-shell-top',{heading:'การชำระเงิน'}) %>

  <% if (saved) { %><div class="ok-note"><iconify-icon icon="mdi:check-circle-outline"></iconify-icon> บันทึกข้อมูลการชำระเงินเรียบร้อยแล้ว</div><% } %>

  <form class="pb" method="post" action="/admin/payment"><input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="panel">
      <div class="ph2"><h3><iconify-icon icon="mdi:credit-card-outline"></iconify-icon> ช่องทางการชำระเงิน</h3></div>
      <div class="pb"><div class="fgrid">
        <div class="fld full">
          <label for="pay-methods">ช่องทางที่แสดงบนหน้าการชำระเงิน เรียงตามลำดับในหน้านี้ (เลขลำดับใส่ให้อัตโนมัติ)</label>
          <p class="hint" data-raw-hint>หนึ่งบรรทัดต่อหนึ่งช่องทาง คั่นด้วย " | " (4 คอลัมน์: เลขลำดับ | ไอคอน Iconify | หัวข้อ | รายละเอียด) ตัวอย่างไอคอน: mdi:bank-outline, mdi:qrcode, mdi:cash-multiple, mdi:credit-card-outline</p>
          <textarea id="pay-methods" name="methods" rows="6" data-row-editor="{&quot;autoNumber&quot;: true, &quot;itemLabel&quot;: &quot;ช่องทาง&quot;, &quot;addLabel&quot;: &quot;เพิ่มช่องทาง&quot;, &quot;columns&quot;: [{&quot;label&quot;: &quot;ไอคอน&quot;, &quot;type&quot;: &quot;icon&quot;}, {&quot;label&quot;: &quot;หัวข้อ&quot;, &quot;placeholder&quot;: &quot;เช่น โอนผ่านธนาคาร&quot;}, {&quot;label&quot;: &quot;รายละเอียด&quot;, &quot;wide&quot;: true, &quot;placeholder&quot;: &quot;เช่น ธนาคารกสิกรไทย ชื่อบัญชี...&quot;}]}" placeholder="01 | mdi:bank-outline | โอนผ่านธนาคาร | ธนาคารกสิกรไทย ชื่อบัญชี..."><%= methodsText %></textarea>
        </div>
      </div></div>
    </div>

    <div class="panel">
      <div class="ph2"><h3><iconify-icon icon="mdi:file-document-outline"></iconify-icon> เงื่อนไขการชำระเงิน</h3></div>
      <div class="pb"><div class="fgrid">
        <div class="fld full">
          <label for="pay-terms">เงื่อนไขที่แสดงบนหน้าการชำระเงิน</label>
          <p class="hint" data-raw-hint>หนึ่งบรรทัดต่อหนึ่งเงื่อนไข คั่นด้วย " | " (2 คอลัมน์: หัวข้อ | รายละเอียด)</p>
          <textarea id="pay-terms" name="terms" rows="6" data-row-editor="{&quot;itemLabel&quot;: &quot;เงื่อนไข&quot;, &quot;addLabel&quot;: &quot;เพิ่มเงื่อนไข&quot;, &quot;columns&quot;: [{&quot;label&quot;: &quot;หัวข้อ&quot;, &quot;placeholder&quot;: &quot;เช่น งานติดตั้งแอร์&quot;}, {&quot;label&quot;: &quot;รายละเอียด&quot;, &quot;wide&quot;: true, &quot;placeholder&quot;: &quot;เช่น มัดจำ 50% ก่อนเริ่มงาน&quot;}]}" placeholder="งานติดตั้งแอร์ | มัดจำ 50% ก่อนเริ่มงาน..."><%= termsText %></textarea>
        </div>
      </div></div>
    </div>

    <button class="btn nv" style="margin-top:4px">บันทึกข้อมูลการชำระเงิน</button>
  </form>

<%- include('../partials/admin-shell-bottom') %>
<script src="/js/admin-row-editor.js" defer></script>
</div>
</body>
</html>
