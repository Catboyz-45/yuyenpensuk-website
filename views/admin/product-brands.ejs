<!doctype html><html lang="th"><head><%- include('../partials/admin-head',{title:'หมวดหมู่แบรนด์'}) %></head><body><div class="cms"><%- include('../partials/admin-shell-top',{heading:'หมวดหมู่แบรนด์'}) %><main class="banana-brands-manager"><div class="banana-brand-head"><div><h2>จัดการแบรนด์สินค้า</h2><p>เพิ่ม แก้ไข เปลี่ยนโลโก้ และลบหมวดหมู่ที่ไม่มีสินค้า</p></div><a class="banana-manage-brands" href="/admin/products">← กลับหน้าสินค้า</a></div><% if(err){ %><p class="banana-brand-message"><%= err %></p><% } %><% if(ok){ %><p style="color:#247722">บันทึกเรียบร้อย</p><% } %><form class="banana-brand-form" action="/admin/product-brands/save" method="post" enctype="multipart/form-data" id="brand-form"><h3 id="brand-form-title">เพิ่มแบรนด์ใหม่</h3><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" id="brand-id"><div class="fields"><div><label for="brand-name">ชื่อแบรนด์</label><input name="name" id="brand-name" maxlength="80" required placeholder="เช่น DAIKIN"></div><div><label for="brand-logo">โลโก้แบรนด์ (JPG, PNG, WebP ไม่เกิน 10 MB)</label><input type="file" name="logo" id="brand-logo" accept=".jpg,.jpeg,.png,.webp"></div></div><button type="submit">บันทึกแบรนด์</button> <button type="button" id="brand-cancel" style="background:#e8efe3">ยกเลิกการแก้ไข</button></form><div class="banana-brand-grid"><% brands.forEach(b=>{ const n=products.filter(p=>String(p.brand||'').toUpperCase()===b.name.toUpperCase()).length; %><div class="banana-brand-card"><span class="banana-brand-logo"><% if(b.logo){ %><img src="<%= b.logo %>" alt="โลโก้ <%= b.name %>"><% }else{ %><span class="banana-brand-wordmark"><%= b.name %></span><% } %></span><div class="banana-brand-info"><strong><%= b.name %></strong><small><%= n %> รุ่นสินค้า</small></div><div class="banana-brand-actions"><button type="button" class="edit" data-id="<%= b.id %>" data-name="<%= b.name %>">แก้ไข</button><form action="/admin/product-brands/delete/<%= b.id %>" method="post" data-confirm="ยืนยันลบแบรนด์นี้?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="delete" type="submit"<% if (n) { %> disabled title="มีสินค้าอยู่ ต้องย้ายหรือลบสินค้าก่อน"<% } %>>ลบ</button></form></div></div><% }) %></div></main><%- include('../partials/admin-shell-bottom') %></div><script src="/js/admin-product-brands.js" defer></script></body></html>