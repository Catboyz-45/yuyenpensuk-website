<header class="sh">
  <a class="lg" href="/">
    <img src="/images/ys-logo.png" class="lg-img company-logo" alt="<%= company.name %>">
    <span class="company-brand-name">อยู่เย็นเป็นสุข วิศวกรรม จำกัด</span>
  </a>
  <nav id="site-primary-nav" aria-label="เมนูหลัก">
    <a href="/" class="<%= active==='home'?'act':'' %>">หน้าแรก</a>
    <a href="/services" class="<%= active==='services'?'act':'' %>">บริการ</a>
    <a href="/products" class="<%= active==='products'?'act':'' %>">สินค้า</a>
    <a href="/pricing-install" class="<%= active==='pricing'?'act':'' %>">ค่าบริการ</a>
    <a href="/projects" class="<%= active==='projects'?'act':'' %>">ผลงาน</a>
    <a href="/payment" class="<%= active==='payment'?'act':'' %>">ชำระเงิน</a>
    <a href="/contact" class="<%= active==='contact'?'act':'' %>">ติดต่อเรา</a>
  </nav>
  <a class="tel" href="tel:<%= company.phone %>"><iconify-icon icon="mdi:phone-outline"></iconify-icon> <%= company.phone %></a>
  <button class="burger" type="button" aria-label="เปิดเมนู" aria-controls="site-primary-nav" aria-expanded="false"><iconify-icon icon="mdi:menu" aria-hidden="true"></iconify-icon></button>
</header>
